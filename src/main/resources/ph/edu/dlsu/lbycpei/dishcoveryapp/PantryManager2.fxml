<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600" prefWidth="1000" styleClass="background"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.dlsu.lbycpei.dishcoveryapp.controller.PantryManagerController">

    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>

    <!-- Header -->
    <StackPane translateY="15.0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <ImageView fitHeight="123.0" fitWidth="695.0">
            <image>
                <Image url="@images/banner.png"/>
            </image>
        </ImageView>
        <Text fill="WHITE" styleClass="header" text="Pantry Manager" textAlignment="CENTER">
            <font>
                <Font size="38.0"/>
            </font>
        </Text>
    </StackPane>

    <!-- Main Scrollable Content -->
    <ScrollPane fitToWidth="true" AnchorPane.bottomAnchor="34.0" AnchorPane.leftAnchor="60.0"
                AnchorPane.rightAnchor="66.0" AnchorPane.topAnchor="160">
        <VBox alignment="TOP_CENTER" spacing="30">
            <Text styleClass="title" text="Your Ingredients:"/>

            <!-- Search bar -->
            <HBox alignment="CENTER" spacing="10">
                <TextField fx:id="ingredientSearchField" editable="true"
                           promptText="Type ingredients (e.g. egg, rice)"
                           style="-fx-font-size: 16px;" prefWidth="400"/>
            </HBox>

            <!-- Buttons -->
            <HBox alignment="CENTER" spacing="15">
                <Button fx:id="backButton" mnemonicParsing="false" text="← Back"/>
                <Button fx:id="matchRecipeButton" mnemonicParsing="false" text="Match Recipe"/>
            </HBox>

            <!-- Recipes Section -->
            <VBox fx:id="ingredientsListContainer" alignment="CENTER_LEFT" spacing="10"
                  style="-fx-border-color: lightgray; -fx-border-radius: 5; -fx-padding: 15;"
                  styleClass="subtitle">

                <Text styleClass="label" text="Recipes you can make:"/>

                <ScrollPane fitToWidth="true" prefHeight="305.0" prefWidth="768.0" vbarPolicy="ALWAYS">
                    <content>
                        <GridPane fx:id="recipesGridPane" gridLinesVisible="false" hgap="20" vgap="20">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="250"/>
                                <ColumnConstraints prefWidth="250"/>
                                <ColumnConstraints prefWidth="250"/>
                            </columnConstraints>
                            <padding>
                                <Insets top="10" left="10" right="10" bottom="10"/>
                            </padding>
                        </GridPane>
                    </content>
                </ScrollPane>
            </VBox>
        </VBox>
    </ScrollPane>
</AnchorPane>
