<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import java.net.URL?>

<BorderPane prefHeight="202.0" prefWidth="340.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>

    <!-- Center Section - Main Content -->
    <center>
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20;">
            <!-- Image Preview -->
            <StackPane style="-fx-border-color: #cccccc; -fx-border-style: dashed; -fx-border-width: 2; -fx-border-radius: 5;">
                <ImageView fx:id="imagePreview" fitHeight="100" fitWidth="100" preserveRatio="true" visible="false" />
                <Text fx:id="placeholderText" style="-fx-fill: #666666;" text="No image" />
            </StackPane>
        </VBox>
    </center>

    <!-- Bottom Section - Buttons -->
    <bottom>
        <VBox alignment="CENTER" prefHeight="21.0" prefWidth="300.0" spacing="10" style="-fx-padding: 10; -fx-background-color: #f5f5f5;">
            <Button fx:id="chooseImageButton" mnemonicParsing="false" prefHeight="29.0" prefWidth="106.0" style="-fx-font-size: 14px; -fx-pref-width: 120;" text="Choose Image" />

            <!-- Format Instructions -->
            <Text style="-fx-font-size: 9; -fx-fill: #666666;" text=".png format only" />
            <Button fx:id="closeButton" alignment="BOTTOM_CENTER" contentDisplay="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" prefHeight="25.0" prefWidth="74.0" style="-fx-font-size: 14px; -fx-pref-width: 80;" text="Close" textAlignment="CENTER" textOverrun="CENTER_ELLIPSIS" HBox.hgrow="NEVER" />
        </VBox>
    </bottom>
</BorderPane>
